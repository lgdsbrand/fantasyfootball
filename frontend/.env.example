# Both values ship to the browser, which is fine: the publishable key can
# only do what your row level security policies allow.

# Supabase -> Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> the PUBLISHABLE key
VITE_SUPABASE_ANON_KEY=

# Only needed in production, when the API is on a different origin.
# Leave blank locally - Vite proxies /api to the backend.
VITE_API_URL=