# --- Supabase -------------------------------------------------------------
# Project Settings -> Data API -> Project URL
SUPABASE_URL=

# Project Settings -> API Keys -> the SECRET key
SUPABASE_SERVICE_ROLE_KEY=

# Only for older projects that still sign tokens with HS256.
# Projects using the newer signing keys need nothing here - the backend
# verifies against the JWKS endpoint automatically. Leave blank.
SUPABASE_JWT_SECRET=

# --- AI (optional) --------------------------------------------------------
# Without a key every endpoint still returns full results; only the
# written analysis is missing.
# console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional fallback, used only if Groq fails.
GEMINI_API_KEY=

# --- Deployment -----------------------------------------------------------
FANTASY_SEASON=2026

# Comma-separated origins allowed to call the API in production.
# Required when the frontend and backend are on different domains,
# for example Vercel calling Render. Leave blank for local development.
FANTASY_ALLOWED_ORIGINS=